# Node Environment
NODE_ENV=development
PORT=4000
APP_ENV=local
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/committee_ledger
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Security & Authentication
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_32_chars
JWT_REFRESH_TTL_SECONDS=604800

# CORS & Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Optional Error Monitoring
SENTRY_DSN=
