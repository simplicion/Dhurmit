---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="How It Works | Dhurmit Committee Ledger" 
  description="Step-by-step guide to running your rotating savings circle, Dhukuti, or chit fund with Dhurmit. Clear workflows for organizers and members."
  activePath="/how-it-works/"
>
  <div class="how-page">
    <!-- Header -->
    <section class="page-hero">
      <div class="container">
        <div class="badge">
          <span class="badge-dot"></span>
          <span>Simple, Verifiable Workflows</span>
        </div>
        <h1 class="page-title">
          How Dhurmit Works: <br />
          <span class="gradient-text">From Formation to Final Payout</span>
        </h1>
        <p class="page-subtitle">
          Whether you are managing a 10-person family circle or a 30-member business trader Dhukuti, here is how Dhurmit brings order to your rotating savings.
        </p>
      </div>
    </section>

    <!-- Organizer Steps -->
    <section class="section-py contrast-section">
      <div class="container">
        <div class="section-header">
          <span class="section-badge">For Committee Organizers</span>
          <h2 class="section-title">Run Your Committee in 4 Easy Steps</h2>
          <p class="section-desc">Eliminate the anxiety of misplaced notes and manual bookkeeping.</p>
        </div>

        <div class="grid-4 steps-grid">
          <!-- Step 1 -->
          <div class="glass-card step-card">
            <div class="step-number">01</div>
            <h3 class="step-title">Configure Group</h3>
            <p class="step-desc">
              Select your country during onboarding. Dhurmit configures your currency, time zone, and calendar (Bikram Sambat BS or Gregorian). Set cycle frequency (monthly, bi-weekly, or weekly) and fixed contribution amount.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="glass-card step-card">
            <div class="step-number">02</div>
            <h3 class="step-title">Add Members</h3>
            <p class="step-desc">
              Input trusted community members with their phone numbers or share your unique 6-digit Committee Join Code so they can sync from their own devices.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="glass-card step-card">
            <div class="step-number">03</div>
            <h3 class="step-title">Set Rotation Turn</h3>
            <p class="step-desc">
              Assign payout order via mutual agreement, fixed lottery sequence, or bidding round. Every participant knows their exact scheduled payout date upfront.
            </p>
          </div>

          <!-- Step 4 -->
          <div class="glass-card step-card">
            <div class="step-number">04</div>
            <h3 class="step-title">Log & Distribute</h3>
            <p class="step-desc">
              As members pay via physical cash or bank transfer, tap to mark them "Paid on Time", "Paid Late", or "Partial". Dhurmit automatically allocates funds, calculates penalties, and generates WhatsApp receipts.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Member Steps -->
    <section class="section-py">
      <div class="container">
        <div class="section-header">
          <span class="section-badge">For Group Members</span>
          <h2 class="section-title">Zero Hassle: Join via Bottom Sheet</h2>
          <p class="section-desc">Members don't need to configure complex settings. You only need 30 seconds to audit your dues.</p>
        </div>

        <div class="grid-3 member-steps-grid">
          <div class="glass-card member-step-card">
            <div class="member-step-header">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
              </span>
              <span class="member-step-num">Step 1</span>
            </div>
            <h3 class="card-title">Tap "Join as Member"</h3>
            <p class="feature-text">
              Open the Dhurmit app and click the dedicated member link directly on the home screen. A clean bottom sheet slides up immediately.
            </p>
          </div>

          <div class="glass-card member-step-card">
            <div class="member-step-header">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
                  <path d="M21 2l-2 2m-1.5 1.5L16 7l-2-2-1.5 1.5M19 5l-7 7-4-4-5 5a2.828 2.828 0 0 0 4 4l5-5 4 4 7-7z"></path>
                  <circle cx="7.5" cy="16.5" r="1.5"></circle>
                </svg>
              </span>
              <span class="member-step-num">Step 2</span>
            </div>
            <h3 class="card-title">Enter Phone & Code</h3>
            <p class="feature-text">
              Enter your registered mobile number and the committee join code provided by your organizer. No complicated passwords required.
            </p>
          </div>

          <div class="glass-card member-step-card">
            <div class="member-step-header">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              </span>
              <span class="member-step-num">Step 3</span>
            </div>
            <h3 class="card-title">Instant Truth & Transparency</h3>
            <p class="feature-text">
              View your payment history, upcoming deadlines, outstanding fines (if any), and exact rotation turn. Zero doubts, zero disputes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="section-py contrast-section">
      <div class="container">
        <div class="section-header">
          <span class="section-badge">Why It Matters</span>
          <h2 class="section-title">Paper Register vs Dhurmit Digital Ledger</h2>
          <p class="section-desc">See the mathematical and operational differences side-by-side.</p>
        </div>

        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Capability / Feature</th>
                <th class="col-paper">Paper Notebooks / Excel</th>
                <th class="col-dhurmit">Dhurmit Digital Ledger</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Decimal Precision</strong></td>
                <td class="text-danger">Rounding errors accumulate; lost fractions</td>
                <td class="text-success"><strong>BigInt Paisa Precision (0.00% Drift)</strong></td>
              </tr>
              <tr>
                <td><strong>Offline Usability</strong></td>
                <td class="text-warning">Physical book needed; damage or loss risk</td>
                <td class="text-success"><strong>100% Offline SQLite; auto-syncs</strong></td>
              </tr>
              <tr>
                <td><strong>Arrears Settlement</strong></td>
                <td class="text-danger">Manual confusion over penalties vs principal</td>
                <td class="text-success"><strong>Automatic FIFO Arrears Sequencing</strong></td>
              </tr>
              <tr>
                <td><strong>Member Access</strong></td>
                <td class="text-danger">Members must ask organizer for photo copies</td>
                <td class="text-success"><strong>Instant Member Bottom-Sheet Portal</strong></td>
              </tr>
              <tr>
                <td><strong>Receipt Generation</strong></td>
                <td class="text-danger">Hand-written slips or manual SMS typing</td>
                <td class="text-success"><strong>1-Tap Pre-Formatted WhatsApp Receipts</strong></td>
              </tr>
              <tr>
                <td><strong>Auditability & Security</strong></td>
                <td class="text-danger">Easily altered, torn, or lost pages</td>
                <td class="text-success"><strong>Cryptographic state checks & tamper-evident logs</strong></td>
              </tr>
              <tr>
                <td><strong>Custodial Risk</strong></td>
                <td class="text-warning">Cash held in physical envelope</td>
                <td class="text-success"><strong>Pure software ledger (Zero custody risk)</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to action -->
    <section class="section-py">
      <div class="container text-center">
        <h2 class="section-title" style="margin-bottom: 14px;">Ready to Modernize Your Committee?</h2>
        <p class="section-desc" style="max-width: 580px; margin: 0 auto 30px auto;">
          Download Dhurmit today and set up your first circle in under 3 minutes.
        </p>
        <a href="#download" class="btn btn-primary" style="padding: 14px 32px; font-size: 15px;">
          Download on Google Play
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .how-page {
    padding-bottom: 60px;
  }

  .page-hero {
    padding-top: 60px;
    padding-bottom: 60px;
    text-align: center;
  }

  .page-title {
    font-size: 44px;
    font-weight: 800;
    margin-top: 18px;
    margin-bottom: 18px;
    line-height: 1.15;
    color: var(--text-main);
  }

  .page-subtitle {
    font-size: 16.5px;
    color: var(--text-body);
    max-width: 660px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .steps-grid {
    align-items: stretch;
  }

  .step-card {
    position: relative;
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
  }

  .step-number {
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 900;
    color: #93c5fd;
    margin-bottom: 12px;
    line-height: 1;
  }

  .step-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 10px;
  }

  .step-desc {
    font-size: 13.5px;
    color: var(--text-body);
    line-height: 1.6;
  }

  .member-step-card {
    padding: 32px;
  }

  .member-step-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
  }

  .member-step-num {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    background: #dbeafe;
    border: 1px solid #bfdbfe;
    color: #1e40af;
    border-radius: 4px;
  }

  /* Comparison Table */
  .table-wrapper {
    overflow-x: auto;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 640px;
  }

  .comparison-table th {
    background: #f8fafc;
    padding: 16px 24px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-main);
    border-bottom: 1px solid #cbd5e1;
  }

  .col-paper {
    color: #b91c1c !important;
  }

  .col-dhurmit {
    color: #1e40af !important;
  }

  .comparison-table td {
    padding: 16px 24px;
    font-size: 14px;
    border-bottom: 1px solid #e2e8f0;
    color: var(--text-body);
  }

  .comparison-table tr:last-child td {
    border-bottom: none;
  }

  .text-danger {
    color: #b91c1c;
  }

  .text-warning {
    color: #c2410c;
  }

  .text-success {
    color: #15803d;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 32px;
    }
    .step-card {
      padding: 24px 20px;
    }
  }
</style>
