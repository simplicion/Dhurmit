---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Dhurmit | The Offline-First Committee & Dhukuti Ledger" 
  description="Manage community savings, ROSCA committees, and Dhukuti groups with zero arithmetic errors. Offline-first, paisa-precision, and 100% transparent."
  activePath="/"
>
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="badge">
          <span class="badge-dot"></span>
          <span>Next-Gen Committee & Dhukuti Ledger</span>
        </div>

        <h1 class="hero-title">
          Eliminate Ledger Disputes. <br />
          <span class="gradient-text">Pure Mathematical Trust</span> <br />
          For Your Committee.
        </h1>

        <p class="hero-description">
          Dhurmit is the offline-first mobile ledger engineered for community organizers, ROSCAs, Chit Funds, and Dhukuti groups. Track every member's contribution with paisa precision, zero floating-point errors, and instant member transparency.
        </p>

        <div class="hero-actions">
          <a href="#download" class="btn btn-primary hero-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.072 2.072 0 0 1-.22-.387V2.202c.067-.142.142-.272.22-.388zm11.238 11.24L17.5 15.75l-12.87 7.43a2.04 2.04 0 0 1-1.02.26 2.044 2.044 0 0 1-.806-.164l12.043-10.222zm0-2.108L2.804.724A2.044 2.044 0 0 1 3.61.56c.36 0 .717.094 1.02.264l12.87 7.426-2.653 2.696zm1.488 1.488l3.415 1.97c.767.442.767 1.162 0 1.604l-3.415 1.97-1.74-1.772 1.74-1.772z"/>
            </svg>
            <span>Download on Google Play</span>
          </a>

          <a href="/features/" class="btn btn-secondary">
            <span>Explore All Features</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Trust Metrics -->
        <div class="hero-metrics">
          <div class="metric-item">
            <span class="metric-val">100%</span>
            <span class="metric-lbl">Offline SQLite Sync</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">BigInt</span>
            <span class="metric-lbl">Zero Decimal Drift</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">0.00%</span>
            <span class="metric-lbl">Custodial Risk (Pure Ledger)</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual: Corporate Mockup Card -->
      <div class="hero-visual">
        <div class="mockup-frame">
          <div class="mockup-header">
            <div class="mockup-header-title">
              <span class="live-dot"></span>
              <span>Pokhara Traders Dhukuti 2026</span>
            </div>
            <span class="cycle-pill">Cycle #07 / 12</span>
          </div>

          <div class="pool-summary-box">
            <div class="pool-meta">
              <span class="pool-label">Monthly Pot Payout</span>
              <span class="pool-amount">रू 1,200,000</span>
            </div>
            <div class="progress-bar-container">
              <div class="progress-bar-fill" style="width: 83%;"></div>
            </div>
            <div class="pool-status-row">
              <span>10 of 12 Contributed</span>
              <span class="highlight-green">रू 1,000,000 Collected</span>
            </div>
          </div>

          <!-- Member Transaction Rows strictly per Section 5 of design MD -->
          <div class="mockup-list">
            <div class="mockup-item">
              <div class="item-avatar avatar-blue">RA</div>
              <div class="item-info">
                <span class="item-name">Ramesh Adhikari</span>
                <span class="item-sub">Paid via Cash • Oct 14</span>
              </div>
              <span class="status-pill status-paid">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Paid on Time
              </span>
            </div>

            <div class="mockup-item">
              <div class="item-avatar avatar-orange">ST</div>
              <div class="item-info">
                <span class="item-name">Sita Thapa</span>
                <span class="item-sub">Paid via Bank Transfer • Oct 16</span>
              </div>
              <span class="status-pill status-late">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                Paid Late (+Fine)
              </span>
            </div>

            <div class="mockup-item">
              <div class="item-avatar avatar-purple">BS</div>
              <div class="item-info">
                <span class="item-name">Binod Shrestha</span>
                <span class="item-sub">Partial: रू 50,000 / 100,000</span>
              </div>
              <span class="status-pill status-partial">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                Partial
              </span>
            </div>

            <div class="mockup-item">
              <div class="item-avatar avatar-red">KG</div>
              <div class="item-info">
                <span class="item-name">Kiran Gurung</span>
                <span class="item-sub">Due 3 days ago • WhatsApp Sent</span>
              </div>
              <span class="status-pill status-overdue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                Overdue
              </span>
            </div>
          </div>

          <div class="mockup-footer">
            <span class="security-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              Cryptographically Verified Ledger
            </span>
            <span class="audit-id">Hash: #a98f...d3e1</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM VS SOLUTION -->
  <section class="section-py contrast-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">The Paradigm Shift</span>
        <h2 class="section-title">Replace Chaotic Paper Registers With Absolute Precision</h2>
        <p class="section-desc">Traditional community committees collapse when hand-written notes get lost, late-fee math causes arguments, or members lose trust. Dhurmit restores harmony.</p>
      </div>

      <div class="grid-2 comparison-grid">
        <!-- Old Way -->
        <div class="glass-card problem-card">
          <div class="card-tag tag-danger">Traditional Way (Notebooks & Excel)</div>
          <h3 class="card-title text-red">Manual Headaches & Disputes</h3>
          <ul class="comparison-list">
            <li>
              <span class="cross-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </span>
              <span><strong>Lost or Torn Notebooks:</strong> Misplaced physical registers or water spills erase years of community records.</span>
            </li>
            <li>
              <span class="cross-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </span>
              <span><strong>Floating-Point Math Errors:</strong> Manual arithmetic slips lead to missing fractions and bitter accusations.</span>
            </li>
            <li>
              <span class="cross-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </span>
              <span><strong>Arrears Confusion:</strong> Debating whether a partial cash payment clears this month or last month's penalty.</span>
            </li>
            <li>
              <span class="cross-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </span>
              <span><strong>Exhausting Phone Calls:</strong> Organizers spending entire weekends manually texting and chasing members.</span>
            </li>
          </ul>
        </div>

        <!-- Dhurmit Way -->
        <div class="glass-card solution-card">
          <div class="card-tag tag-success">The Dhurmit Standard</div>
          <h3 class="card-title text-blue">Tamper-Evident Peace of Mind</h3>
          <ul class="comparison-list">
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Offline-First SQLite:</strong> Records stay 100% accessible on your phone, even without cellular coverage.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>BigInt Paisa Precision:</strong> Stored as exact integer smallest units (paisa/cents). Absolutely zero rounding drift.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>Strict FIFO Settlement:</strong> Payments automatically clear oldest overdue balances and penalties first.</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span><strong>1-Tap WhatsApp Receipts:</strong> Instant transparent breakdown cards sent straight to members' phones.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE COMMITTEE CALCULATOR -->
  <section id="calculator" class="section-py">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">Interactive Simulation</span>
        <h2 class="section-title">Model Your Committee In Real-Time</h2>
        <p class="section-desc">Configure your group size and contribution to preview monthly pot sizes, rotation cycles, and total capital mobilized.</p>
      </div>

      <div class="glass-card calculator-card">
        <div class="calculator-grid">
          <!-- Controls -->
          <div class="calc-controls">
            <div class="form-group">
              <div class="slider-header">
                <label for="member-slider">Number of Members</label>
                <span id="member-val" class="slider-display">12 Members</span>
              </div>
              <input type="range" id="member-slider" min="3" max="30" value="12" class="range-slider" />
              <div class="slider-ticks">
                <span>3</span>
                <span>10</span>
                <span>20</span>
                <span>30</span>
              </div>
            </div>

            <div class="form-group">
              <div class="slider-header">
                <label for="amount-slider">Monthly Contribution per Member</label>
                <span id="amount-val" class="slider-display">रू 10,000</span>
              </div>
              <input type="range" id="amount-slider" min="1000" max="100000" step="1000" value="10000" class="range-slider" />
              <div class="slider-ticks">
                <span>रू 1k</span>
                <span>रू 25k</span>
                <span>रू 50k</span>
                <span>रू 100k</span>
              </div>
            </div>

            <div class="form-group">
              <label for="cycle-type">Cycle Frequency</label>
              <select id="cycle-type" class="custom-select">
                <option value="monthly">Monthly Rotation (Standard Dhukuti / Chit Fund)</option>
                <option value="biweekly">Bi-Weekly Rotation (Quick Fund)</option>
                <option value="weekly">Weekly Rotation (Market Guild)</option>
              </select>
            </div>
          </div>

          <!-- Live Result Display -->
          <div class="calc-results">
            <h4 class="results-heading">Calculated Ledger Output</h4>
            
            <div class="result-highlight-box">
              <span class="result-label">Single Round Pot Payout</span>
              <span id="payout-total" class="result-amount">रू 120,000</span>
              <span class="result-sub">Distributed to each winning member in rotation</span>
            </div>

            <div class="stats-mini-grid">
              <div class="mini-stat">
                <span class="mini-label">Total Committee Duration</span>
                <span id="duration-val" class="mini-val">12 Months</span>
              </div>
              <div class="mini-stat">
                <span class="mini-label">Total Capital Mobilized</span>
                <span id="capital-total" class="mini-val">रू 1,440,000</span>
              </div>
              <div class="mini-stat">
                <span class="mini-label">Net Lifetime Obligation</span>
                <span id="member-total" class="mini-val">रू 120,000</span>
              </div>
              <div class="mini-stat">
                <span class="mini-label">Accounting Discrepancy</span>
                <span class="mini-val text-green">0.00% Guaranteed</span>
              </div>
            </div>

            <div class="calc-cta-row">
              <a href="#download" class="btn btn-primary" style="width: 100%;">
                Start This Committee on Dhurmit
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 CORE PILLARS GRID -->
  <section class="section-py contrast-section">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">Engineered For Communities</span>
        <h2 class="section-title">Built Specially For The Reality of ROSCAs</h2>
        <p class="section-desc">From village bazaar Dhukuti circles to diaspora apartment committees, Dhurmit handles every edge case seamlessly.</p>
      </div>

      <div class="grid-3">
        <!-- Feature 1 -->
        <div class="glass-card feature-box">
          <div class="feature-icon-wrapper icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <h3 class="feature-title">Smart Calendar & Geo-Location</h3>
          <p class="feature-text">Select your country during onboarding to dynamically adapt currencies, time zones, and dual Gregorian / Bikram Sambat calendar dates.</p>
        </div>

        <!-- Feature 2 -->
        <div class="glass-card feature-box">
          <div class="feature-icon-wrapper icon-sky">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h3 class="feature-title">Dual Organizer & Member Portal</h3>
          <p class="feature-text">Organizers manage the full ledger with payment logs, while members join via a quick bottom-sheet to audit their own dues and payout turn.</p>
        </div>

        <!-- Feature 3 -->
        <div class="glass-card feature-box">
          <div class="feature-icon-wrapper icon-green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="feature-title">Automated FIFO Arrears Flow</h3>
          <p class="feature-text">When a member pays partially, Dhurmit automatically allocates funds to their oldest outstanding month and penalties before touching the current cycle.</p>
        </div>

        <!-- Feature 4 -->
        <div class="glass-card feature-box">
          <div class="feature-icon-wrapper icon-orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <h3 class="feature-title">Instant WhatsApp Statements</h3>
          <p class="feature-text">Generate professional, pre-formatted WhatsApp and SMS receipt summaries with one tap. Keep every participant informed and accountable.</p>
        </div>

        <!-- Feature 5 -->
        <div class="glass-card feature-box">
          <div class="feature-icon-wrapper icon-purple">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
              <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
            </svg>
          </div>
          <h3 class="feature-title">100% Offline-First SQLite</h3>
          <p class="feature-text">Record payments deep inside vegetable wholesale markets or remote valleys without cellular reception. Auto-syncs seamlessly once back online.</p>
        </div>

        <!-- Feature 6 -->
        <div class="glass-card feature-box">
          <div class="feature-icon-wrapper icon-indigo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="feature-title">Zero Custodial Liability</h3>
          <p class="feature-text">Dhurmit does not touch a single rupee or dollar. You maintain physical or bank custody; Dhurmit provides unassailable mathematical records.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GOOGLE PLAY DOWNLOAD SECTION -->
  <section id="download" class="section-py download-banner-section">
    <div class="container">
      <div class="download-banner-card">
        <div class="download-banner-content">
          <span class="badge download-badge">
            <span class="badge-dot"></span>
            <span>Android Release v1.0.0</span>
          </span>

          <h2 class="download-title">Ready To Upgrade Your Committee Ledger?</h2>
          <p class="download-text">
            Join hundreds of committee organizers and members who run on mathematical transparency. Available now on Android devices via Google Play.
          </p>

          <div class="download-btn-group">
            <a href="https://play.google.com/store/apps/details?id=app.dhurmit.com" target="_blank" rel="noopener noreferrer" class="playstore-big-btn">
              <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a2.072 2.072 0 0 1-.22-.387V2.202c.067-.142.142-.272.22-.388zm11.238 11.24L17.5 15.75l-12.87 7.43a2.04 2.04 0 0 1-1.02.26 2.044 2.044 0 0 1-.806-.164l12.043-10.222zm0-2.108L2.804.724A2.044 2.044 0 0 1 3.61.56c.36 0 .717.094 1.02.264l12.87 7.426-2.653 2.696zm1.488 1.488l3.415 1.97c.767.442.767 1.162 0 1.604l-3.415 1.97-1.74-1.772 1.74-1.772z"/>
              </svg>
              <div class="play-btn-labels">
                <span class="play-sub">GET IT ON</span>
                <span class="play-main">Google Play</span>
              </div>
            </a>

            <div class="trust-notice">
              <span class="trust-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Verified Google Play Developer
              </span>
              <span class="trust-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Regular Security Audits
              </span>
              <span class="trust-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Pure Local Privacy
              </span>
            </div>
          </div>
        </div>

        <div class="download-banner-visual">
          <img src="/logo.png" alt="Dhurmit Official Product Logo" class="banner-app-icon" width="160" height="160" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-section {
    padding-top: 56px;
    padding-bottom: 72px;
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-title {
    font-size: 46px;
    font-weight: 800;
    line-height: 1.15;
    margin-top: 18px;
    margin-bottom: 20px;
    color: var(--text-main);
  }

  .hero-description {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 32px;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .hero-btn {
    padding: 14px 28px;
    font-size: 15px;
  }

  .hero-metrics {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 800;
    color: var(--color-primary);
  }

  .metric-lbl {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .metric-divider {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
  }

  /* Corporate Mockup Frame */
  .mockup-frame {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-xl);
    padding: 24px;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
  }

  .mockup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .mockup-header-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-main);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background: #15803d;
    border-radius: 50%;
  }

  .cycle-pill {
    font-size: 12px;
    font-weight: 700;
    padding: 3px 8px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
