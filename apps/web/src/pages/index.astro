<script>
  // Interactive Calculator Logic
  const memberSlider = document.getElementById('member-slider') as HTMLInputElement | null;
  const amountSlider = document.getElementById('amount-slider') as HTMLInputElement | null;
  const cycleSelect = document.getElementById('cycle-type') as HTMLSelectElement | null;

  const memberVal = document.getElementById('member-val');
  const amountVal = document.getElementById('amount-val');
  const payoutTotal = document.getElementById('payout-total');
  const durationVal = document.getElementById('duration-val');
  const capitalTotal = document.getElementById('capital-total');
  const memberTotal = document.getElementById('member-total');

  function updateCalculator() {
    if (!memberSlider || !amountSlider || !cycleSelect) return;

    const members = parseInt(memberSlider.value, 10);
    const amount = parseInt(amountSlider.value, 10);
    const frequency = cycleSelect.value;

    if (memberVal) memberVal.textContent = `${members} Members`;
    if (amountVal) amountVal.textContent = `रू ${amount.toLocaleString()}`;

    // Single Round Pot Payout
    const pot = members * amount;
    if (payoutTotal) payoutTotal.textContent = `रू ${pot.toLocaleString()}`;

    // Duration text
    let unit = 'Months';
    if (frequency === 'biweekly') unit = 'Bi-Weeks';
    if (frequency === 'weekly') unit = 'Weeks';
    if (durationVal) durationVal.textContent = `${members} ${unit}`;

    // Total Capital Mobilized
    const totalCapital = pot * members;
    if (capitalTotal) capitalTotal.textContent = `रू ${totalCapital.toLocaleString()}`;

    // Member Total Contribution
    if (memberTotal) memberTotal.textContent = `रू ${pot.toLocaleString()}`;
  }

  if (memberSlider && amountSlider && cycleSelect) {
    memberSlider.addEventListener('input', updateCalculator);
    amountSlider.addEventListener('input', updateCalculator);
    cycleSelect.addEventListener('change', updateCalculator);
    updateCalculator();
  }
</script>
