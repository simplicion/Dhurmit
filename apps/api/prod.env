# ==============================================================================
# DHURMIT PRODUCTION ENVIRONMENT CONFIGURATION FOR RENDER
# ==============================================================================
# Instructions:
# 1. In your Render Web Service dashboard, go to "Environment" -> "Add from .env"
# 2. Paste the contents of this file.
# 3. Replace DATABASE_URL with the Database URL provided by Render PostgreSQL.
# ==============================================================================

NODE_ENV=production
APP_ENV=production
PORT=10000
LOG_LEVEL=info

# --- Database Configuration (PostgreSQL) ---
DATABASE_URL=postgres://dhurmit_user:password_from_render@dpg-xxx.oregon-postgres.render.com/dhurmit_production
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Security & Authentication (JWT) ---
JWT_ACCESS_SECRET=dhurmit_prod_access_secret_7f4a9b2c8e1d5f6a3b0c9e8d7f6a5b4c
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_SECRET=dhurmit_prod_refresh_secret_3a8f1e5d7c9b2a4e6f8d0b1c3e5a7f9b
JWT_REFRESH_TTL_SECONDS=604800

# --- CORS & Origins ---
CORS_ALLOWED_ORIGINS=*

# --- 180 Sovereign Identity Authentication ---
180_CLIENT_ID=180_client_3b759b500c4b8a04f888ec3d91a82bd3
180_CLIENT_SECRET=180_secret_c09a40cfc3e5c8acc1dd24ffd499dcd90e2b2773488c2f035765beb8a28eb7f5
180_WEBHOOK_SECRET=whsec_4ea6988e7fca03a2bdb4f7f4316814659a1e056aeb82ce35
ONE_EIGHTY_CLIENT_ID=180_client_3b759b500c4b8a04f888ec3d91a82bd3
ONE_EIGHTY_CLIENT_SECRET=180_secret_c09a40cfc3e5c8acc1dd24ffd499dcd90e2b2773488c2f035765beb8a28eb7f5
ONE_EIGHTY_WEBHOOK_SECRET=whsec_4ea6988e7fca03a2bdb4f7f4316814659a1e056aeb82ce35
ONE_EIGHTY_AUTH_URL=https://auth.180workspace.com
ONE_EIGHTY_API_URL=https://api.180core.cloud

# --- Monitoring (Optional) ---
SENTRY_DSN=
